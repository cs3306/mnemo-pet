# Copy to .env and edit.

# Your numeric user/group id (run `id -u` and `id -g`) so ./data is writable.
PET_UID=1000
PET_GID=1000

# Time zone for the clock used by reminders and the "time" event.
TZ=America/Vancouver

# Optional shared secret for the TCP and HTTP interfaces.
# If set, put the same value in ~/.config/mnemo-pet/extension.json ("token").
PET_TOKEN=

# Ports. `make env` / `./install.sh` generate a random free pair in 20000-32000
# the first time and write them into .env; change them here whenever you like.
# petd, the containers, the plugins, the extension (via install.sh) and the dev
# tools all read these two values. The defaults below are only a fallback.
PET_PORT=23817
PET_HTTP_PORT=23818

# ---- Optional LLM brain -------------------------------------------------------
# Any OpenAI-compatible endpoint, including mnemo's. Empty = no brain; the pet
# still works (animations, reminders, rules, plugins).
BRAIN_URL=
BRAIN_KEY=
BRAIN_MODEL=default
# 1 = send a short "you are a desktop pet, start replies with an [action] tag"
# system prompt. 0 = send none (use when mnemo owns the persona).
BRAIN_SEND_SYSTEM=1
